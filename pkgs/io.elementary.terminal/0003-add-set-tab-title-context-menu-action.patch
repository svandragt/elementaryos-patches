@@ -0,0 +1,40 @@
+/*
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ * SPDX-FileCopyrightText: 2026 elementary, Inc. (https://elementary.io)
+ */
+
+public class Terminal.Dialogs.SetTabTitleDialog : Granite.MessageDialog {
+    private Gtk.Entry title_entry;
+
+    public SetTabTitleDialog (MainWindow parent, string current_title) {
+        Object (
+            transient_for: parent,
+            primary_text: _("Set Tab Title"),
+            secondary_text: _("Leave empty to name the tab automatically again."),
+            buttons: Gtk.ButtonsType.NONE
+        );
+
+        title_entry.text = current_title;
+    }
+
+    construct {
+        modal = true;
+
+        title_entry = new Gtk.Entry () {
+            activates_default = true
+        };
+
+        custom_bin.append (title_entry);
+
+        add_button (_("Cancel"), Gtk.ResponseType.CANCEL);
+
+        var set_button = (Gtk.Button) add_button (_("Set Title"), Gtk.ResponseType.ACCEPT);
+        set_button.add_css_class (Granite.CssClass.SUGGESTED);
+
+        set_default_response (Gtk.ResponseType.ACCEPT);
+    }
+
+    public string get_title_text () {
+        return title_entry.text.strip ();
+    }
+}
